# BuildLog 서버 설정 예시입니다.
# 이 파일을 같은 폴더에 .env 라는 이름으로 복사한 뒤 값을 바꿔서 사용합니다.
# .env 에는 비밀값이 들어갈 수 있으므로 Git에 기록하지 않습니다.

# 실행 환경: development, test, production 중 하나
APP_ENV=development

# 데이터베이스 주소
# 이 줄을 주석(#)으로 두면 프로젝트의 database/buildlog.sqlite3 (SQLite)를 사용합니다.
# Supabase를 쓸 때는 앞의 #을 지우고 Supabase에서 받은 연결 주소를 넣습니다. (Phase 13)
# DATABASE_URL=
