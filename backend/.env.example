# BuildLog 서버 설정 예시입니다.
# 이 파일을 같은 폴더(backend)에 .env 라는 이름으로 복사한 뒤 값을 바꿔서 사용합니다.
# .env 에는 비밀번호가 들어가므로 Git에 기록하지 않습니다. (.gitignore로 제외되어 있습니다)

# 실행 환경: development, test, production 중 하나
APP_ENV=development

# 데이터베이스 주소 (필수, 기본값 없음)
# Supabase 대시보드 > 프로젝트 > Connect > "Session pooler" 의 주소를 그대로 붙여 넣습니다.
# 형식: postgresql://postgres.프로젝트ID:비밀번호@aws-0-지역.pooler.supabase.com:5432/postgres
#  - 주소 안의 [YOUR-PASSWORD] 는 [ ] 괄호까지 지우고 실제 비밀번호로 바꿉니다.
#  - 비밀번호에 @ : / ? # % 같은 특수문자가 있으면 %40 처럼 변환해 넣습니다. (어려우면 특수문자 없는 비밀번호로 재설정)
#  - 아래 줄 맨 앞의 #은 지우고 값을 채웁니다.
# DATABASE_URL=

# ---------------------------------------------------------------------------
# AI 요약 (학습 자료함에 올린 이미지·영상을 OpenAI로 요약합니다)
# ---------------------------------------------------------------------------
# OpenAI API 키. 이것 하나만 넣으면 AI 요약이 켜집니다. 비워 두면 AI 요약만 꺼지고 나머지는 그대로 동작합니다.
#  - https://platform.openai.com/api-keys 에서 만든 키를 그대로 붙여 넣습니다. (sk- 로 시작)
#  - 키를 넣거나 바꾼 뒤에는 백엔드를 다시 켜야 반영됩니다.
#  - 이 파일(.env.example)에는 실제 키를 적지 않습니다. 키는 backend/.env 에만 넣습니다.
#  - 연결 확인: backend 폴더에서  .\.venv\Scripts\python -m app.tools.check_ai
# OPENAI_API_KEY=

# 사용할 모델 (선택). 비워 두면 기본 모델(gpt-6-luna)을 씁니다.
# OPENAI_MODEL=

# 사용자 1명이 하루(한국 날짜 기준)에 요청할 수 있는 AI 요약 횟수 (선택, 기본 30). 비용을 막는 안전장치입니다.
# AI_DAILY_LIMIT=30
